# Required: choose a unique password with at least 12 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Required: generate at least 32 random characters. Keep separate from ADMIN_PASSWORD.
SESSION_SECRET=replace-with-at-least-32-random-characters

OPENROUTER_API_KEY=sk-or-v1-replace-me
SMTP2GO_API_KEY=api-replace-me
SENDER_EMAIL=alerts@example.com
RECIPIENT_EMAIL=recipient@example.com

# Required: Vercel Cron sends this value as an Authorization Bearer token.
CRON_SECRET=replace-with-at-least-32-random-characters

APP_URL=http://localhost:3000

# Exact HTTPS hostnames only, comma-separated. Leave empty to disable server-side
# remote-image fetching; data-image results continue to work without this setting.
REMOTE_IMAGE_ALLOWED_HOSTS=
